# Supabase Configuration
# Current Supabase key names (replaces the legacy "anon key" / "service role
# key" naming). The publishable key is safe to expose client-side by design;
# the secret key is privileged and must stay server-only — never prefix it
# with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Application URL & Site Settings
# In production this MUST be the real production domain — it is used to build
# canonical URLs, Open Graph URLs, sitemap.xml, and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email Notification Targets
BUSINESS_NOTIFICATION_EMAIL=
ADMIN_NOTIFICATION_EMAIL=

# Production Email Delivery (Resend)
# Resend API key for transactional email delivery (lead notifications,
# review-request emails). Leave blank to keep email notifications in safe
# development-logger mode — no real email is ever sent without this set.
# Never expose this value client-side (no NEXT_PUBLIC_ prefix).
RESEND_API_KEY=
# Verified "from" address/domain for outgoing email, e.g.
# "OC Water Features <leads@ocwaterfeatures.com>". Required alongside
# RESEND_API_KEY before real email delivery is attempted.
EMAIL_FROM_ADDRESS=

# Third-Party Integrations
# Google Business Profile review link shown on the post-review "Leave a
# Google Review" CTA. Client-visible by design (NEXT_PUBLIC_) since it's
# read in the browser after a customer submits a review. Leave blank until
# a real Google Business Profile review URL exists — the CTA simply does
# not render rather than linking to an invented placeholder.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# SEO / Analytics (Phase 0)
# GA4 Measurement ID from Google Analytics (format: G-XXXXXXXXXX). Leave blank
# to disable analytics entirely — no script is loaded and tracking calls
# no-op when this is unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Google Search Console "HTML tag" verification value (just the content
# attribute, not the full <meta> tag). Leave blank until Hector adds and
# verifies the property in Search Console — see docs/seo-optimization-plan.md.
GOOGLE_SITE_VERIFICATION=

# Development Seeding Control (Refuses execution unless explicitly true in dev)
ALLOW_DEVELOPMENT_SEED=false
